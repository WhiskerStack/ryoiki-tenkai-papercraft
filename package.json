{
  "name": "catalogo-papercraft",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "catalog": "node scripts/generate-catalog.mjs",
    "webp": "node scripts/convert-to-webp.mjs",
