---
// Nube estilo pixel-art inspirada en el fondo de referencia.
interface Props {
	width?: number;
	class?: string;
	style?: string;
}

const { width = 160, class: className, style } = Astro.props;
---

<svg
	class:list={['pixel-cloud', className]}
	style={style}
	width={width}
	viewBox="0 0 32 13"
	shape-rendering="crispEdges"
	aria-hidden="true"
>
	<g fill="#c7b2f2">
		<rect x="11" y="0" width="6" height="1"></rect>
		<rect x="9" y="1" width="10" height="2"></rect>
		<rect x="19" y="2" width="5" height="2"></rect>
		<rect x="5" y="3" width="21" height="2"></rect>
		<rect x="3" y="5" width="26" height="2"></rect>
		<rect x="1" y="7" width="30" height="2"></rect>
	</g>
	<g fill="#a993e3">
		<rect x="1" y="9" width="30" height="2"></rect>
		<rect x="3" y="11" width="26" height="1"></rect>
		<rect x="6" y="7" width="7" height="2"></rect>
		<rect x="18" y="6" width="8" height="1"></rect>
	</g>
	<g fill="#e6dbff">
		<rect x="11" y="1" width="4" height="1"></rect>
		<rect x="7" y="4" width="5" height="1"></rect>
	</g>
</svg>
