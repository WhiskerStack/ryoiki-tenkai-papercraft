---
// Tarjeta tipo "vídeo de YouTube": miniatura dentro de una ventanita retro + datos debajo.
import { CHANNEL } from '../config';

interface Props {
	number: number;
	name: string;
	src: string;
	index: number;
}

const { number, name, src: path, index } = Astro.props;
const src = `${import.meta.env.BASE_URL}${path}`;
const code = String(number).padStart(3, '0');
const title = name || `Papercraft Nº ${number}`;
const label = name ? `${name} · Papercraft Nº ${number}` : title;
---

<li class="card" data-number={number} data-name={name}>
	<button class="card-hit" type="button" data-index={index} aria-label={`Ver ${label}`}>
		<div class="window">
			<div class="window-bar" aria-hidden="true">
				<span class="window-title">papercraft_{code}.jpg</span>
				<span class="window-btns">
					<span>–</span><span>□</span><span>×</span>
				</span>
			</div>
			<div class="thumb">
				<img src={src} alt={label} loading={index < 8 ? 'eager' : 'lazy'} decoding="async" width="600" height="720" />
				<span class="badge">Nº {number}</span>
			</div>
		</div>
	</button>

	<div class="info">
		<div class="text">
			<h3 class="title">{title}</h3>
			<p class="meta">{CHANNEL.name} <span class="check" title="Hecho a mano">✦</span></p>
			<p class="meta">Anime papercraft · #{code}</p>
		</div>
	</div>
</li>

<style>
	.card {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 12px;
		min-width: 0;
		animation: pop-in 0.5s both;
	}

	.card[hidden] {
		display: none;
	}

	.card-hit {
		all: unset;
		cursor: pointer;
		display: block;
		border-radius: var(--radius-lg);
	}

	.card-hit:focus-visible {
		outline: 3px dashed var(--pink-400);
		outline-offset: 4px;
	}

	.window {
		position: relative;
		padding: 6px;
		border-radius: var(--radius-lg);
		background: linear-gradient(160deg, var(--lilac-100), var(--lilac-200));
		border: 2px solid var(--lilac-400);
		box-shadow:
			0 4px 0 var(--lilac-300),
			var(--shadow-soft);
		transition:
			transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
			box-shadow 0.25s;
	}

	.card-hit:hover .window,
	.card-hit:focus-visible .window {
		transform: translateY(-6px) rotate(-0.6deg);
		box-shadow:
			0 6px 0 var(--pink-300),
			0 18px 36px -12px rgba(238, 143, 203, 0.6);
	}

	.window-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		padding: 2px 6px 7px 8px;
		font-family: var(--font-display);
		font-size: 0.72rem;
		color: var(--lilac-700);
	}

	.window-title {
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		opacity: 0.85;
	}

	.window-btns {
		display: flex;
		gap: 3px;
		flex-shrink: 0;
	}

	.window-btns span {
		display: grid;
		place-items: center;
		width: 15px;
		height: 15px;
		font-size: 10px;
		line-height: 1;
		color: var(--lilac-700);
		background: #fde58a;
		border: 1.5px solid var(--lilac-600);
		border-radius: 4px;
	}

	.thumb {
		position: relative;
		overflow: hidden;
		aspect-ratio: 5 / 6;
		border-radius: var(--radius-md);
		border: 2px solid var(--lilac-400);
		background: #fff;
	}

	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.card-hit:hover .thumb img {
		transform: scale(1.05);
	}

	.badge {
		position: absolute;
		right: 8px;
		bottom: 8px;
		padding: 3px 9px;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.8rem;
		color: #fff;
		background: rgba(87, 74, 163, 0.85);
		border-radius: 999px;
		backdrop-filter: blur(4px);
	}

	.info {
		display: flex;
		gap: 10px;
		padding: 0 4px;
	}

	.check {
		color: var(--pink-400);
	}

	.text {
		min-width: 0;
	}

	.title {
		margin: 0 0 4px;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1rem;
		line-height: 1.3;
		color: var(--ink);
	}

	.meta {
		margin: 0;
		font-size: 0.85rem;
		color: var(--ink-soft);
	}

	@media (max-width: 520px) {
		.window-title {
			display: none;
		}
		.window-bar {
			justify-content: flex-end;
		}
		.title {
			font-size: 0.92rem;
		}
		.meta {
			font-size: 0.78rem;
		}
	}

	@keyframes pop-in {
		from {
			opacity: 0;
			transform: translateY(12px) scale(0.97);
		}
	}
</style>
